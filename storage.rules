rules_version = '2';
// spain0511 공용 — mongolia-mission-app + yeohaeng-jugwon 동일 파일 유지
// trips/ Storage는 signedIn() — Firestore에서 데이터 접근 제한
// 변경 후: npm run sync:firebase-rules → firebase deploy --only firestore:rules,storage
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isSettlementUser() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // --- 몽골선교 정산 영수증 (Email/Password만) ---
    match /missions/{missionId}/settlementReceipts/{allPaths=**} {
      allow read, write: if isSettlementUser();
    }

    // --- 몽골선교 공유 앨범 (missions/.../album/) ---
    // 주의: {allPaths=**} 전체 매치로 두면 Storage 규칙의 OR 평가 때문에
    // settlementReceipts 제한이 우회되므로 album 하위로만 한정한다.
    match /missions/{missionId}/album/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // --- 여행주권 (trips/.../tickets/, album/) ---
    match /trips/{tripId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /tickets/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /trip-album/{fileName} {
      allow read, write: if signedIn();
    }

    match /expense-receipts/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}
