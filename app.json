{
  "expo": {
    "name": "RiseUp",
    "slug": "mongolia-mission-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C1F26"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yeun.riseupmongolia",
      "infoPlist": {
        "CFBundleDisplayName": "RiseUp",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "정산 영수증 촬영을 위해 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "카톡 공유와 정산 영수증 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
        "LSApplicationQueriesSchemes": ["kakaotalk"]
      }
    },
    "android": {
      "package": "com.yeun.riseupmongolia",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#87CEEB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "카톡 공유와 정산 영수증 첨부를 위해 사진 라이브러리 접근이 필요합니다.",
          "cameraPermission": "정산 영수증 촬영을 위해 카메라 접근이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "./plugins/withKakaoTalkQueries.js"
    ],
    "extra": {
      "eas": {
        "projectId": "1fe98eee-8c99-45df-b93c-7998305f1be7"
      }
    },
    "owner": "slitlamp2"
  }
}
